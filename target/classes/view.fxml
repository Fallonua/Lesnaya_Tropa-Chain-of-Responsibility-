<?xml version="1.0" encoding="UTF-8"?>
<!--
  Разметка главного экрана игры «Лесная тропа».
  Корневой элемент — VBox; контроллер — lesnayatropa.controller.Controller.
  Элементы с fx:id привязываются к полям контроллера; onAction — к методам onPathChosen / onRestart.
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- Корневой контейнер: вертикальное выравнивание по центру, фон лесного оттенка -->
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="lesnayatropa.controller.Controller"
      alignment="CENTER" spacing="20" style="-fx-background-color: #1a2f1a;">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <!-- Заголовок игры -->
    <Text text="Лесная тропа" style="-fx-fill: #e8dcc4; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <!-- Описание цели; &#10; — перенос строки -->
    <Label fx:id="goalLabel" text="Цель: найти выход из леса. &#10;Выберите тропинку (каждый шаг −1 энергия)."
           wrapText="true" style="-fx-text-fill: #c4b896; -fx-font-size: 15px;" maxWidth="500"/>
    <!-- Статистика: монеты, здоровье, энергия (значения обновляются в Controller.updateLabels) -->
    <GridPane fx:id="statsPane" hgap="15" vgap="8" alignment="CENTER">
        <Label text="Монеты:" style="-fx-text-fill: #e8dcc4; -fx-font-size: 16px;"/>
        <Label fx:id="coinsLabel" text="10" GridPane.columnIndex="1" style="-fx-text-fill: #f0e6c8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Здоровье:" style="-fx-text-fill: #e8dcc4; -fx-font-size: 16px;" GridPane.rowIndex="1"/>
        <Label fx:id="healthLabel" text="10" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #f0e6c8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Энергия:" style="-fx-text-fill: #e8dcc4; -fx-font-size: 16px;" GridPane.rowIndex="2"/>
        <Label fx:id="energyLabel" text="10" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #f0e6c8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </GridPane>
    <!-- Номер текущего шага (обновляется в Controller.updateLabels) -->
    <Label fx:id="stepLabel" text="Шаг: 0" style="-fx-text-fill: #a8b898; -fx-font-size: 16px;"/>
    <!-- Кнопки выбора пути: все вызывают onPathChosen; выбор направления не влияет на результат (событие определяется цепочкой) -->
    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnLeft" text="Налево" onAction="#onPathChosen" style="-fx-base: #2d4a2d; -fx-text-fill: #e8dcc4; -fx-font-size: 15px;"/>
        <Button fx:id="btnStraight" text="Прямо" onAction="#onPathChosen" style="-fx-base: #2d4a2d; -fx-text-fill: #e8dcc4; -fx-font-size: 15px;"/>
        <Button fx:id="btnRight" text="Направо" onAction="#onPathChosen" style="-fx-base: #2d4a2d; -fx-text-fill: #e8dcc4; -fx-font-size: 15px;"/>
    </HBox>
    <!-- Кнопка перезапуска игры без перезапуска приложения (onRestart) -->
    <Button fx:id="btnRestart" text="Начать сначала" onAction="#onRestart" style="-fx-base: #3d5a3d; -fx-text-fill: #e8dcc4; -fx-font-size: 15px;"/>
</VBox>
